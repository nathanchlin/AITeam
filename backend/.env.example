# GLM API Configuration
# Get your API key from https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here
# Available models: glm-4-flash (推荐), glm-4, glm-4-plus, glm-4-air
# glm-4-flash: 最快最便宜，推荐日常使用
# glm-4: 标准模型
# glm-4-plus: 更强性能，适合复杂任务
GLM_MODEL=glm-4-flash  # 推荐：免费额度，速度快

# GLM Base URL (可选)
# 使用 Coding Plan 流量: https://open.bigmodel.cn/api/coding/paas/v4
# 使用普通 Web API: https://open.bigmodel.cn/api/paas/v4 (默认)
# 如果已购买 Coding Plan 套餐，建议配置下方地址：
# GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./aiteam.db
