# GLM API Configuration
# Get your API key from https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here

# 通用模型：用于聊天、讨论、任务拆解、计划生成
# GLM-4.7-Flash: 快速响应，适合对话类任务
GLM_MODEL=glm-4.7-flash
GLM_BASE_URL=

# 代码生成专用：用于代码编程类任务
# GLM-5.1: 更强的代码生成能力
GLM_CODING_MODEL=glm-5.1
GLM_CODING_BASE_URL=

# Rate limiting: minimum interval (seconds) between API calls to avoid 429 errors
# Default: 1.5s. Increase if you still hit rate limits with many agents.
GLM_REQUEST_INTERVAL=1.5

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./aiteam.db
