# GLM API Configuration
# Get your API key from https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here

# 常规任务模型 (分析、讨论、计划生成)
# Available models: glm-4-flash, glm-4, glm-4-plus, glm-5 (推荐)
GLM_MODEL=glm-5
GLM_BASE_URL=

# 代码生成专用 (更强的代码能力)
# 推荐使用 GLM-5 + Coding Plan 获得最佳代码生成效果
GLM_CODING_MODEL=glm-5
GLM_CODING_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./aiteam.db
